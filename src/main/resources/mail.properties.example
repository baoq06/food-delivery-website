# ==============================================================================
# CẤU HÌNH GỬI EMAIL THẬT QUA GMAIL SMTP (Gửi được đến mọi email bất kỳ)
# ==============================================================================
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.starttls.required=true
mail.smtp.ssl.protocols=TLSv1.2 TLSv1.3

# Email Gmail của bạn (dùng để gửi đi)
mail.smtp.username=your_gmail@gmail.com
mail.from.email=your_gmail@gmail.com
mail.from.name=Utee Food Delivery

# Mật khẩu ứng dụng 16 ký tự của Google (tạo tại: https://myaccount.google.com/apppasswords)
mail.smtp.password=your_16_char_app_password

# ==============================================================================
# CẤU HÌNH DỰ PHÒNG RESEND API (Chỉ dùng khi chưa điền mail.smtp.username/password)
# ==============================================================================
# resend.api.key=re_your_api_key_here
